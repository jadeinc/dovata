// 04 — JSON array via explicit GBNF.
// Exercises recursive grammar for a collection; asserts a non-empty parsed array.

use std::json

let ARR_GBNF = """root ::= "[" ws num (ws "," ws num)* ws "]"
num  ::= "-"? [0-9]+
ws   ::= [ ]*"""

let ok = false
let detail = ""
try {
    let g = Grammar.new(ARR_GBNF)
    prompt p = "List the first 5 prime numbers as a JSON array of integers, nothing else."
    let resp = ?p |> g
    detail = resp
    let arr = json.parse(resp)
    ok = len(arr) > 0
} catch e {
    detail = f"raised: {e}"
}

if ok {
    print(f"PASS: JSON array grammar produced a non-empty parsed array  [{detail}]")
} else {
    print(f"FAIL: JSON array grammar — {detail}")
}
