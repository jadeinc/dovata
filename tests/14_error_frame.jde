// 14 — A failure arrives as a catchable Jade error, not a hang or an empty reply.
//
// The protocol says a failed request is a single Error frame and no further
// frames, and that the caller raises it so a `?p` inside a `try` can catch it.
// Every other eval here asserts the success path; this one asserts the failure
// path is wired, because a broken error path does not look like an error. It
// looks like the model saying nothing, which is far harder to diagnose than a
// raise.
//
// The trigger is a syntactically invalid GBNF. It has to fail, on any model, with
// no dependence on sampling — unlike provoking a real inference error, which is
// neither reliable nor cheap.

let ok = false
let detail = ""
let raised = false

// Not valid GBNF: `root` refers to a rule that was never defined.
let BROKEN_GBNF = 'root ::= undefined_rule_that_does_not_exist'

try {
    let g = Grammar.new(BROKEN_GBNF)
    prompt p = "Say anything at all."
    let resp = ?p |> g
    // Reaching here means the bad grammar was accepted and generation proceeded,
    // which is the actual bug: a malformed constraint silently ignored.
    detail = f"no error raised; got: {resp.trim()}"
} catch e {
    raised = true
    detail = f"{e}"
}

// The message is not asserted on — it belongs to the engine and may be reworded.
// What must hold is that the failure surfaced as a catchable Jade error.
ok = raised && detail.len() > 0

if ok {
    print(f"PASS: invalid grammar surfaced as a catchable error  [{detail}]")
} else {
    print(f"FAIL: error propagation — {detail}")
}
