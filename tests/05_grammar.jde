// 05 — Explicit GBNF via Grammar.new (no anchor — grammar enforced from token 1).
// Exercises: full-grammar path with a user-supplied GBNF. Output must match.

let ok = false
let detail = ""
try {
    let g = Grammar.new('root ::= "yes" | "no"')
    prompt p = "Is water wet? Answer with exactly one word: yes or no."
    let ans = ?p |> g
    detail = ans.trim()
    let norm = detail.lower()
    ok = norm == "yes" || norm == "no"
} catch e {
    detail = f"raised: {e}"
}

if ok {
    print(f"PASS: explicit GBNF constrained the output to the grammar  [{detail}]")
} else {
    print(f"FAIL: grammar match — got {detail}")
}
