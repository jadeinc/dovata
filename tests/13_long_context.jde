// 13 — A needle survives a long prompt (RULER-style, small).
//
// The profile advertises a 262144-token window, but that figure needs the MoE
// expert-offload driver enabled; without it the engine serves JADE_CTX_SIZE,
// default 32768. So this stays deliberately small — a few thousand tokens of
// filler — and tests the mechanism rather than the frontier: that a long prompt
// is accepted, prefilled, and that a fact buried in its middle is still
// retrievable.
//
// Sized to fit the default window with room to spare, so it is a correctness test
// on any configuration. The real frontier measurement is JADE_FRONTIER's job and
// wants a harness that can sweep sizes; this just catches a long prompt being
// silently truncated, which would otherwise look like the model forgetting.

use std::time

let nonce = time.now_ms()

let ok = false
let detail = ""
try {
    // ~40 chars per line, 400 lines ≈ 16k chars ≈ 4k tokens.
    let filler = []
    let i = 0
    while i < 400 {
        filler.push(f"Line {i}: routine log entry, nothing of note here.")
        i = i + 1
    }

    // Needle in the middle, where a truncating engine would drop it whichever end
    // it cut from.
    filler[200] = f"Line 200: the maintenance passphrase is HELIOTROPE-{nonce}."

    let corpus = ""
    for line in filler {
        corpus = corpus + line + "\n"
    }

    prompt p = f"""{corpus}
Read the log above. What is the maintenance passphrase? Reply with only the word before the hyphen."""
    let reply = ?p
    detail = f"corpus={corpus.len()} chars, reply={reply.trim()}"
    ok = reply.upper().contains("HELIOTROPE")
} catch e {
    detail = f"raised: {e}"
}

if ok {
    print(f"PASS: needle retrieved from a long prompt  [{detail}]")
} else {
    print(f"FAIL: long-context retrieval — {detail}")
}
