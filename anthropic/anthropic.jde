// Anthropic (Claude) — provider conforming to ovata-infer-protocol.
//
// The inference interface is the wire protocol: infer() consumes an ovata
// InferenceRequest (prompt, model, max_tokens, grammar, ...) and returns the response
// as protocol Frames. Per the protocol a provider emits Token(s) then Done, or a
// single Error; the HOST emits the leading Meta frame, so this provider does not.
// Frames are the contract's data types — no wire encoding here; the host encodes.
//
// The knobs the wire protocol does not carry (temperature, tools, system, top_p, ...)
// live in a separate `params` value that COMPLEMENTS the request — see Params below.
//
//     use anthropic
//     let p = anthropic.params({ "temperature": 0.2, "system": "Be terse.",
//                                "tools": [ anthropic.tool("get_time", "...", schema) ] })
//     let frames = anthropic.infer(request, p)   // request = ovata InferenceRequest
//
// API key: ANTHROPIC_API_KEY, else ~/.jade/providers/anthropic.json (see api_key()).

use std::http
use std::json
use std::env
use std::fs

let NAME = "anthropic"
let API_VERSION = "2023-06-01"
let DEFAULT_MODEL = "claude-sonnet-5"
let DEFAULT_MAX_TOKENS = 4096

// ── Frame constructors — mirror ovata-infer-protocol response.rs Frame variants ──
// A provider emits Token(s) then Done, or one Error. Meta is the host's, not ours.
fn token(text)          { return { "type": "Token", "text": text } }
fn done(tokens_used)    { return { "type": "Done", "tokens_used": tokens_used } }
fn error(message)       { return { "type": "Error", "message": message } }
fn json_frame(payload)  { return { "type": "Json", "json": payload } }

// ── Params — the provider-specific complement to the wire request ──
// A plain map of only the knobs you set; anything absent takes the API default.
// params() validates and passes them through.
fn params(opts) {
    let p = {}
    if opts.has("temperature") {
        let t = opts["temperature"]
        if t < 0.0 || t > 1.0 {
            raise f"anthropic: temperature {t} out of range [0.0, 1.0]"
        }
        p["temperature"] = t
    }
    if opts.has("top_p")          { p["top_p"] = opts["top_p"] }
    if opts.has("top_k")          { p["top_k"] = opts["top_k"] }
    if opts.has("stop_sequences") { p["stop_sequences"] = opts["stop_sequences"] }
    if opts.has("system")         { p["system"] = opts["system"] }
    if opts.has("tools")          { p["tools"] = opts["tools"] }
    if opts.has("tool_choice")    { p["tool_choice"] = opts["tool_choice"] }
    if opts.has("thinking")       { p["thinking"] = opts["thinking"] }
    if opts.has("metadata")       { p["metadata"] = opts["metadata"] }
    return p
}

// Tool declaration + tool_choice + extended thinking helpers.
fn tool(name, description, schema) {
    return { "name": name, "description": description, "input_schema": schema }
}
fn choice_auto() { return { "type": "auto" } }
fn choice_any()  { return { "type": "any" } }
fn choice_tool(name) { return { "type": "tool", "name": name } }
fn thinking(budget_tokens) { return { "type": "enabled", "budget_tokens": budget_tokens } }

// ── Endpoint + key ──
fn base_url() {
    let b = env.get("ANTHROPIC_BASE_URL")
    if b == nil { return "https://api.anthropic.com" }
    return b
}
fn config_path() { return env.get("HOME") + "/.jade/providers/anthropic.json" }
fn api_key() {
    let e = env.get("ANTHROPIC_API_KEY")
    if e != nil { return e }
    let path = config_path()
    if fs.exists(path) {
        let cfg = json.parse(fs.read(path))
        if cfg.has("api_key") { return cfg["api_key"] }
    }
    return nil
}

// ── Request building ──
// The wire request carries a flat `prompt`; Claude wants a messages array, so the
// prompt becomes a single user turn. `system` (from params) is top-level, not a turn.
fn build_body(request, params) {
    let body = { "messages": [{ "role": "user", "content": request["prompt"] }] }

    if request.has("model") && len(request["model"]) > 0 {
        body["model"] = request["model"]
    } else {
        body["model"] = DEFAULT_MODEL
    }
    if request.has("max_tokens") && request["max_tokens"] > 0 {
        body["max_tokens"] = request["max_tokens"]
    } else {
        body["max_tokens"] = DEFAULT_MAX_TOKENS
    }
    if params.has("system")         { body["system"] = params["system"] }
    if params.has("temperature")    { body["temperature"] = params["temperature"] }
    if params.has("top_p")          { body["top_p"] = params["top_p"] }
    if params.has("top_k")          { body["top_k"] = params["top_k"] }
    if params.has("stop_sequences") { body["stop_sequences"] = params["stop_sequences"] }
    if params.has("tools")          { body["tools"] = params["tools"] }
    if params.has("tool_choice")    { body["tool_choice"] = params["tool_choice"] }
    if params.has("thinking")       { body["thinking"] = params["thinking"] }
    if params.has("metadata")       { body["metadata"] = params["metadata"] }

    return json.stringify(body)
}

// ── infer: ovata InferenceRequest + params -> [Frame] ──
// Success -> [Token(text)?, Json(tool_calls)?, Done(tokens_used)]; failure -> [Error].
fn infer(request, params) {
    // Reject request features a remote API can't honor (see the InferenceRequest fields).
    if request.has("rlm") && request["rlm"] {
        return [ error("anthropic: rlm mode is not supported by a remote provider") ]
    }
    if request.has("grammar") && request["grammar"] != nil {
        return [ error("anthropic: grammar/constrained decoding is not supported by a remote provider") ]
    }
    let key = api_key()
    if key == nil {
        return [ error("anthropic: no API key — set ANTHROPIC_API_KEY or add api_key to ~/.jade/providers/anthropic.json") ]
    }

    let body = build_body(request, params)
    let resp = http.post(base_url() + "/v1/messages", body, {
        "x-api-key": key,
        "anthropic-version": API_VERSION,
        "content-type": "application/json",
    })
    if resp["status"] != 200 {
        return [ error(f"anthropic: HTTP {resp['status']}: {resp['body']}") ]
    }

    let doc = json.parse(resp["body"])
    let out = []

    // Text blocks -> a Token frame; tool_use blocks -> a Json frame.
    let text = ""
    let calls = []
    for block in doc["content"] {
        if block["type"] == "text" {
            text = text + block["text"]
        }
        if block["type"] == "tool_use" {
            calls.push({ "id": block["id"], "name": block["name"], "input": block["input"] })
        }
    }
    if len(text) > 0 {
        out.push(token(text))
    }
    if len(calls) > 0 {
        out.push(json_frame(json.stringify({ "tool_calls": calls, "stop_reason": doc["stop_reason"] })))
    }

    let usage = doc["usage"]
    out.push(done(usage["input_tokens"] + usage["output_tokens"]))
    return out
}
