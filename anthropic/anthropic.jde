// Anthropic (Claude) — provider library, written in Jade.
//
// The ovata wire protocol exists for LOCAL inference (the llama engine behind the
// daemon). A remote API like Claude is just HTTP, so it needs no daemon and no
// native provider .so — it is a plain Jade library that builds the request, calls
// the Messages API directly over std::http, and parses the reply.
//
//     use anthropic::anthropic          // register [lib.anthropic] -> this dir
//
//     let tools = [ anthropic.tool("get_time", "Current time in a city",
//                     { "type": "object", "properties": { "city": { "type": "string" } } }) ]
//     let reply = anthropic.complete(
//         [{ "role": "user", "content": "What time is it in Tokyo?" }],
//         { "temperature": 0.2, "tools": tools, "tool_choice": anthropic.choice_auto() })
//
//     let call = anthropic.tool_call(reply)   // { id, name, args } or nil
//     print(anthropic.text(reply))            // assistant text
//
// The API key is read from ANTHROPIC_API_KEY in the calling program's environment.
// Point ANTHROPIC_BASE_URL at a gateway/proxy to override the endpoint.

use std::http
use std::json
use std::env

// Claude models this library targets (one Messages-API shape covers them all).
let MODELS = ["claude-opus-4-8", "claude-sonnet-5", "claude-haiku-4-5"]
let API_VERSION = "2023-06-01"
let DEFAULT_MODEL = "claude-sonnet-5"
// Messages requires max_tokens; substitute this when the caller omits it rather
// than failing the request.
let DEFAULT_MAX_TOKENS = 4096

// base_url() -> the API root, overridable via ANTHROPIC_BASE_URL (gateways/proxies).
fn base_url() {
    let b = env.get("ANTHROPIC_BASE_URL")
    if b == nil {
        return "https://api.anthropic.com"
    }
    return b
}

// ── Request building ─────────────────────────────────────────────────────────

// build_body(messages, opts) -> the request JSON string. Only the knobs present
// in `opts` are sent; the rest take the API default. Ranges are validated (an
// out-of-range temperature raises rather than being sent).
fn build_body(messages, opts) {
    let body = { "messages": messages }

    if opts.has("model") {
        body["model"] = opts["model"]
    } else {
        body["model"] = DEFAULT_MODEL
    }
    if opts.has("max_tokens") {
        body["max_tokens"] = opts["max_tokens"]
    } else {
        body["max_tokens"] = DEFAULT_MAX_TOKENS
    }
    // system is top-level in the Messages API, not a message.
    if opts.has("system") {
        body["system"] = opts["system"]
    }
    if opts.has("temperature") {
        let t = opts["temperature"]
        if t < 0.0 || t > 1.0 {
            raise f"anthropic: temperature {t} out of range [0.0, 1.0]"
        }
        body["temperature"] = t
    }
    if opts.has("top_p")          { body["top_p"] = opts["top_p"] }
    if opts.has("top_k")          { body["top_k"] = opts["top_k"] }
    if opts.has("stop_sequences") { body["stop_sequences"] = opts["stop_sequences"] }
    if opts.has("tools")          { body["tools"] = opts["tools"] }
    if opts.has("tool_choice")    { body["tool_choice"] = opts["tool_choice"] }
    if opts.has("thinking")       { body["thinking"] = opts["thinking"] }
    if opts.has("metadata")       { body["metadata"] = opts["metadata"] }
    if opts.has("service_tier")   { body["service_tier"] = opts["service_tier"] }

    return json.stringify(body)
}

// ── The call ─────────────────────────────────────────────────────────────────

// complete(messages, opts) -> the parsed Messages response dict. `messages` is
// [ { "role": str, "content": str }, ... ]; pass `{}` for no options. Raises on a
// missing key or a non-200 response. Feed the result to text()/tool_call()/etc.
fn complete(messages, opts) {
    let key = env.get("ANTHROPIC_API_KEY")
    if key == nil {
        raise "anthropic: ANTHROPIC_API_KEY is not set in the environment"
    }
    let body = build_body(messages, opts)
    let resp = http.post(base_url() + "/v1/messages", body, {
        "x-api-key": key,
        "anthropic-version": API_VERSION,
        "content-type": "application/json",
    })
    if resp["status"] != 200 {
        raise f"anthropic: HTTP {resp['status']}: {resp['body']}"
    }
    return json.parse(resp["body"])
}

// ask(content, opts) -> the assistant's text for a single user turn. Sugar over
// complete() + text() for the common one-shot, no-tools case.
fn ask(content, opts) {
    let reply = complete([{ "role": "user", "content": content }], opts)
    return text(reply)
}

// ── Tool declaration helpers ────────────────────────────────────────────────

// tool(name, description, schema) -> a Claude tool definition. `schema` is a
// JSON-schema dict describing the tool's input object.
fn tool(name, description, schema) {
    return { "name": name, "description": description, "input_schema": schema }
}

// tool_choice: let the model decide / force some tool / force a named tool.
fn choice_auto() { return { "type": "auto" } }
fn choice_any()  { return { "type": "any" } }
fn choice_tool(name) { return { "type": "tool", "name": name } }

// thinking(budget_tokens) -> extended-thinking config for opts["thinking"].
fn thinking(budget_tokens) {
    return { "type": "enabled", "budget_tokens": budget_tokens }
}

// ── Response parsing ─────────────────────────────────────────────────────────
//
// `reply` is the parsed dict returned by complete(). A content block is either
// { "type":"text", "text": str } or
// { "type":"tool_use", "id": str, "name": str, "input": {...} }.

// text(reply) -> the concatenated text of every text block ("" if none).
fn text(reply) {
    let out = ""
    for block in reply["content"] {
        if block["type"] == "text" {
            out = out + block["text"]
        }
    }
    return out
}

// tool_calls(reply) -> [ { id, name, args }, ... ] in order, empty when none.
// `args` is the tool input as a dict (re-stringify with json.stringify if needed).
fn tool_calls(reply) {
    let out = []
    for block in reply["content"] {
        if block["type"] == "tool_use" {
            out.push({ "id": block["id"], "name": block["name"], "args": block["input"] })
        }
    }
    return out
}

// tool_call(reply) -> the first tool call, or nil.
fn tool_call(reply) {
    let calls = tool_calls(reply)
    if len(calls) == 0 {
        return nil
    }
    return calls[0]
}

// stop_reason(reply) -> "end_turn" | "tool_use" | "max_tokens" | "stop_sequence".
// A "tool_use" stop reason means the model is waiting on a tool result.
fn stop_reason(reply) {
    return reply["stop_reason"]
}

// usage(reply) -> { input_tokens, output_tokens }.
fn usage(reply) {
    return reply["usage"]
}
