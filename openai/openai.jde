// OpenAI — provider library, written in Jade.
//
// A remote API is just HTTP, so OpenAI needs no daemon and no native provider .so.
// This is a self-contained Jade library that builds the Chat Completions request,
// calls the API directly over std::http, and parses the reply. (The ovata wire
// protocol and daemon are for LOCAL llama inference only.)
//
//     use openai::openai                  // register [lib.openai] -> this dir
//
//     let tools = [ openai.tool("get_time", "Current time in a city",
//                     { "type": "object", "properties": { "city": { "type": "string" } } }) ]
//     let reply = openai.complete(
//         [{ "role": "user", "content": "What time is it in Tokyo?" }],
//         { "temperature": 0.2, "tools": tools, "tool_choice": openai.choice_auto() })
//
//     let call = openai.tool_call(reply)   // { id, name, args } or nil (args is a JSON string)
//     print(openai.text(reply))            // assistant text
//
// The API key is read from OPENAI_API_KEY in the calling program's environment.
// Point OPENAI_BASE_URL at a gateway/proxy (or Azure/OpenAI-compatible host).

use std::http
use std::json
use std::env

let MODELS = ["gpt-4o", "gpt-4o-mini", "o3", "o4-mini"]
let DEFAULT_MODEL = "gpt-4o"
let DEFAULT_MAX_TOKENS = 4096

// base_url() -> the API root, overridable via OPENAI_BASE_URL (gateways/proxies).
fn base_url() {
    let b = env.get("OPENAI_BASE_URL")
    if b == nil {
        return "https://api.openai.com"
    }
    return b
}

// ── Request building ─────────────────────────────────────────────────────────

// build_messages(messages, opts) -> the message list. Unlike Claude, OpenAI takes
// the system prompt as a leading {role:"system"} message, so opts["system"] is
// prepended here rather than sent as a top-level field.
fn build_messages(messages, opts) {
    if opts.has("system") {
        let out = [{ "role": "system", "content": opts["system"] }]
        for m in messages {
            out.push(m)
        }
        return out
    }
    return messages
}

// build_body(messages, opts) -> the request JSON string. Only the knobs present in
// `opts` are sent; the rest take the API default. Ranges are validated.
fn build_body(messages, opts) {
    let body = { "messages": build_messages(messages, opts) }

    if opts.has("model") {
        body["model"] = opts["model"]
    } else {
        body["model"] = DEFAULT_MODEL
    }
    if opts.has("max_tokens") {
        body["max_tokens"] = opts["max_tokens"]
    } else {
        body["max_tokens"] = DEFAULT_MAX_TOKENS
    }
    if opts.has("temperature") {
        let t = opts["temperature"]
        if t < 0.0 || t > 2.0 {
            raise f"openai: temperature {t} out of range [0.0, 2.0]"
        }
        body["temperature"] = t
    }
    if opts.has("top_p")             { body["top_p"] = opts["top_p"] }
    if opts.has("frequency_penalty") { body["frequency_penalty"] = opts["frequency_penalty"] }
    if opts.has("presence_penalty")  { body["presence_penalty"] = opts["presence_penalty"] }
    if opts.has("stop")              { body["stop"] = opts["stop"] }
    if opts.has("seed")              { body["seed"] = opts["seed"] }
    if opts.has("n")                 { body["n"] = opts["n"] }
    if opts.has("tools")             { body["tools"] = opts["tools"] }
    if opts.has("tool_choice")       { body["tool_choice"] = opts["tool_choice"] }
    if opts.has("response_format")   { body["response_format"] = opts["response_format"] }
    if opts.has("metadata")          { body["metadata"] = opts["metadata"] }

    return json.stringify(body)
}

// ── The call ─────────────────────────────────────────────────────────────────

// complete(messages, opts) -> the parsed Chat Completions response dict. `messages`
// is [ { "role": str, "content": str }, ... ]; pass `{}` for no options. Raises on
// a missing key or a non-200 response. Feed the result to text()/tool_call()/etc.
fn complete(messages, opts) {
    let key = env.get("OPENAI_API_KEY")
    if key == nil {
        raise "openai: OPENAI_API_KEY is not set in the environment"
    }
    let body = build_body(messages, opts)
    let resp = http.post(base_url() + "/v1/chat/completions", body, {
        "Authorization": "Bearer " + key,
        "content-type": "application/json",
    })
    if resp["status"] != 200 {
        raise f"openai: HTTP {resp['status']}: {resp['body']}"
    }
    return json.parse(resp["body"])
}

// ask(content, opts) -> the assistant's text for a single user turn. Sugar over
// complete() + text() for the common one-shot, no-tools case.
fn ask(content, opts) {
    let reply = complete([{ "role": "user", "content": content }], opts)
    return text(reply)
}

// ── Tool declaration helpers ────────────────────────────────────────────────

// tool(name, description, schema) -> an OpenAI function-tool definition. `schema`
// is a JSON-schema dict describing the function's parameters.
fn tool(name, description, schema) {
    return { "type": "function",
             "function": { "name": name, "description": description, "parameters": schema } }
}

// tool_choice: let the model decide / never call / must call some tool / a named tool.
fn choice_auto()     { return "auto" }
fn choice_none()     { return "none" }
fn choice_required() { return "required" }
fn choice_tool(name) { return { "type": "function", "function": { "name": name } } }

// response_format helpers: force a JSON object, or a named JSON schema.
fn json_object() { return { "type": "json_object" } }
fn json_schema(name, schema) {
    return { "type": "json_schema", "json_schema": { "name": name, "schema": schema } }
}

// ── Response parsing ─────────────────────────────────────────────────────────
//
// `reply` is the parsed dict from complete(). The first choice's message holds the
// content and any tool calls:
//   message.content: str | null
//   message.tool_calls: [ { id, type:"function", function:{ name, arguments } } ]
// where `arguments` is a JSON *string* (OpenAI does not parse it for you).

fn message(reply) {
    return reply["choices"][0]["message"]
}

// text(reply) -> the assistant's text ("" when the turn is only tool calls).
fn text(reply) {
    let msg = message(reply)
    if msg.has("content") {
        let c = msg["content"]
        if c != nil {
            return c
        }
    }
    return ""
}

// tool_calls(reply) -> [ { id, name, args }, ... ] in order, empty when none.
// `args` is the raw JSON-string arguments; json.parse it to get a dict.
fn tool_calls(reply) {
    let msg = message(reply)
    let out = []
    if msg.has("tool_calls") {
        for tc in msg["tool_calls"] {
            out.push({ "id": tc["id"], "name": tc["function"]["name"], "args": tc["function"]["arguments"] })
        }
    }
    return out
}

// tool_call(reply) -> the first tool call, or nil.
fn tool_call(reply) {
    let calls = tool_calls(reply)
    if len(calls) == 0 {
        return nil
    }
    return calls[0]
}

// finish_reason(reply) -> "stop" | "length" | "tool_calls" | "content_filter".
fn finish_reason(reply) {
    return reply["choices"][0]["finish_reason"]
}

// usage(reply) -> { prompt_tokens, completion_tokens, total_tokens }.
fn usage(reply) {
    return reply["usage"]
}
