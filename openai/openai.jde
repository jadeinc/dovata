// OpenAI — provider conforming to ovata-infer-protocol.
//
// The inference interface is the wire protocol: infer() consumes an ovata
// InferenceRequest (prompt, model, max_tokens, grammar, ...) and returns the response
// as protocol Frames. Per the protocol a provider emits Token(s) then Done, or a
// single Error; the HOST emits the leading Meta frame, so this provider does not.
// Frames are the contract's data types — no wire encoding here; the host encodes.
//
// The knobs the wire protocol does not carry (temperature, tools, system, top_p, ...)
// live in a separate `params` value that COMPLEMENTS the request — see Params below.
//
//     use openai
//     let p = openai.params({ "temperature": 0.2, "system": "Be terse.",
//                             "tools": [ openai.tool("get_time", "...", schema) ] })
//     let frames = openai.infer(request, p)   // request = ovata InferenceRequest
//
// API key: OPENAI_API_KEY, else ~/.jade/providers/openai.json (see api_key()).

use std::http
use std::json
use std::env
use std::fs

let NAME = "openai"
let DEFAULT_MODEL = "gpt-4o"
let DEFAULT_MAX_TOKENS = 4096

// ── Frame constructors — mirror ovata-infer-protocol response.rs Frame variants ──
// A provider emits Token(s) then Done, or one Error. Meta is the host's, not ours.
fn token(text)          { return { "type": "Token", "text": text } }
fn done(tokens_used)    { return { "type": "Done", "tokens_used": tokens_used } }
fn error(message)       { return { "type": "Error", "message": message } }
fn json_frame(payload)  { return { "type": "Json", "json": payload } }

// ── Params — the provider-specific complement to the wire request ──
// A plain map of only the knobs you set; anything absent takes the API default.
fn params(opts) {
    let p = {}
    if opts.has("temperature") {
        let t = opts["temperature"]
        if t < 0.0 || t > 2.0 {
            raise f"openai: temperature {t} out of range [0.0, 2.0]"
        }
        p["temperature"] = t
    }
    if opts.has("top_p")             { p["top_p"] = opts["top_p"] }
    if opts.has("frequency_penalty") { p["frequency_penalty"] = opts["frequency_penalty"] }
    if opts.has("presence_penalty")  { p["presence_penalty"] = opts["presence_penalty"] }
    if opts.has("stop")              { p["stop"] = opts["stop"] }
    if opts.has("seed")              { p["seed"] = opts["seed"] }
    if opts.has("n")                 { p["n"] = opts["n"] }
    if opts.has("system")            { p["system"] = opts["system"] }
    if opts.has("tools")             { p["tools"] = opts["tools"] }
    if opts.has("tool_choice")       { p["tool_choice"] = opts["tool_choice"] }
    if opts.has("response_format")   { p["response_format"] = opts["response_format"] }
    if opts.has("metadata")          { p["metadata"] = opts["metadata"] }
    return p
}

// Tool declaration + tool_choice + response_format helpers.
fn tool(name, description, schema) {
    return { "type": "function",
             "function": { "name": name, "description": description, "parameters": schema } }
}
fn choice_auto()     { return "auto" }
fn choice_none()     { return "none" }
fn choice_required() { return "required" }
fn choice_tool(name) { return { "type": "function", "function": { "name": name } } }
fn json_object() { return { "type": "json_object" } }
fn json_schema(name, schema) {
    return { "type": "json_schema", "json_schema": { "name": name, "schema": schema } }
}

// ── Endpoint + key ──
fn base_url() {
    let b = env.get("OPENAI_BASE_URL")
    if b == nil { return "https://api.openai.com" }
    return b
}
fn config_path() { return env.get("HOME") + "/.jade/providers/openai.json" }
fn api_key() {
    let e = env.get("OPENAI_API_KEY")
    if e != nil { return e }
    let path = config_path()
    if fs.exists(path) {
        let cfg = json.parse(fs.read(path))
        if cfg.has("api_key") { return cfg["api_key"] }
    }
    return nil
}

// ── Request building ──
// The wire request carries a flat `prompt`; Chat Completions wants a messages array.
// Unlike Claude, `system` is a leading role:"system" message (not a top-level field),
// so it is prepended here; then the wire prompt becomes the user turn.
fn build_body(request, params) {
    let messages = []
    if params.has("system") {
        messages.push({ "role": "system", "content": params["system"] })
    }
    messages.push({ "role": "user", "content": request["prompt"] })
    let body = { "messages": messages }

    if request.has("model") && len(request["model"]) > 0 {
        body["model"] = request["model"]
    } else {
        body["model"] = DEFAULT_MODEL
    }
    if request.has("max_tokens") && request["max_tokens"] > 0 {
        body["max_tokens"] = request["max_tokens"]
    } else {
        body["max_tokens"] = DEFAULT_MAX_TOKENS
    }
    if params.has("temperature")       { body["temperature"] = params["temperature"] }
    if params.has("top_p")             { body["top_p"] = params["top_p"] }
    if params.has("frequency_penalty") { body["frequency_penalty"] = params["frequency_penalty"] }
    if params.has("presence_penalty")  { body["presence_penalty"] = params["presence_penalty"] }
    if params.has("stop")              { body["stop"] = params["stop"] }
    if params.has("seed")              { body["seed"] = params["seed"] }
    if params.has("n")                 { body["n"] = params["n"] }
    if params.has("tools")             { body["tools"] = params["tools"] }
    if params.has("tool_choice")       { body["tool_choice"] = params["tool_choice"] }
    if params.has("response_format")   { body["response_format"] = params["response_format"] }
    if params.has("metadata")          { body["metadata"] = params["metadata"] }

    return json.stringify(body)
}

// ── infer: ovata InferenceRequest + params -> [Frame] ──
// Success -> [Token(text)?, Json(tool_calls)?, Done(tokens_used)]; failure -> [Error].
fn infer(request, params) {
    // Reject request features a remote API can't honor (see the InferenceRequest fields).
    if request.has("rlm") && request["rlm"] {
        return [ error("openai: rlm mode is not supported by a remote provider") ]
    }
    if request.has("grammar") && request["grammar"] != nil {
        return [ error("openai: grammar/constrained decoding is not supported by a remote provider") ]
    }
    if request.has("count_only") && request["count_only"] {
        return [ error("openai: count_only is not supported — OpenAI has no server-side tokenizer endpoint") ]
    }
    let key = api_key()
    if key == nil {
        return [ error("openai: no API key — set OPENAI_API_KEY or add api_key to ~/.jade/providers/openai.json") ]
    }

    let body = build_body(request, params)
    let resp = http.post(base_url() + "/v1/chat/completions", body, {
        "Authorization": f"Bearer {key}",
        "content-type": "application/json",
    })
    if resp["status"] != 200 {
        return [ error(f"openai: HTTP {resp['status']}: {resp['body']}") ]
    }

    let doc = json.parse(resp["body"])
    let choice = doc["choices"][0]
    let msg = choice["message"]
    let out = []

    // content -> a Token frame ("" / null when the turn is only tool calls).
    if msg.has("content") {
        let c = msg["content"]
        if c != nil {
            if len(c) > 0 {
                out.push(token(c))
            }
        }
    }
    // tool_calls -> a Json frame. OpenAI leaves `arguments` as a JSON string.
    let calls = []
    if msg.has("tool_calls") {
        for tc in msg["tool_calls"] {
            calls.push({ "id": tc["id"], "name": tc["function"]["name"], "arguments": tc["function"]["arguments"] })
        }
    }
    if len(calls) > 0 {
        out.push(json_frame(json.stringify({ "tool_calls": calls, "finish_reason": choice["finish_reason"] })))
    }

    out.push(done(doc["usage"]["total_tokens"]))
    return out
}
