// OpenAI — model-profile package, conforming to ovata-infer-protocol.
//
// The inference call is PROTOCOL-PURE: infer(request) takes an ovata InferenceRequest
// (the user's request — prompt/model/max_tokens/…) and returns protocol Frames (the
// model response + the metadata the protocol requires). Nothing provider-specific is
// on that call.
//
// The fixed per-request parameters OpenAI needs but the protocol does not carry —
// api_key, tools, temperature, system, … — are held as the profile's CONFIG and set at
// runtime via configure(); body-building and auth are entirely internal. The config is
// runtime-MUTABLE: change tools/params between requests and the next infer() uses them.
//
//     use openai
//     openai.configure({ "temperature": 0.2, "system": "Be terse.",
//                        "tools": [ openai.tool("get_time", "...", schema) ] })
//     let frames = openai.infer({ "prompt": "What time is it in Tokyo?" })
//     openai.set_tools([])                    // mutate; next infer() reflects it

use std::http
use std::json
use std::env
use std::fs

let NAME = "openai"
let DEFAULT_MODEL = "gpt-4o"
let DEFAULT_MAX_TOKENS = 4096

// ── The profile's runtime-mutable config (the fixed per-request parameters) ──
// nil = unset → not sent (the API default applies). Set via configure()/set_tools().
let config = {
    "api_key": nil,
    "base_url": nil,
    "model": nil,
    "max_tokens": nil,
    "temperature": nil,
    "top_p": nil,
    "frequency_penalty": nil,
    "presence_penalty": nil,
    "stop": nil,
    "seed": nil,
    "n": nil,
    "system": nil,
    "tools": nil,
    "tool_choice": nil,
    "response_format": nil,
    "metadata": nil,
}

// configure(opts) — set any subset of the profile's parameters. Runtime-mutable.
fn configure(opts) {
    if opts.has("temperature") {
        let t = opts["temperature"]
        if t < 0.0 || t > 2.0 {
            raise f"openai: temperature {t} out of range [0.0, 2.0]"
        }
    }
    if opts.has("api_key")           { config["api_key"] = opts["api_key"] }
    if opts.has("base_url")          { config["base_url"] = opts["base_url"] }
    if opts.has("model")             { config["model"] = opts["model"] }
    if opts.has("max_tokens")        { config["max_tokens"] = opts["max_tokens"] }
    if opts.has("temperature")       { config["temperature"] = opts["temperature"] }
    if opts.has("top_p")             { config["top_p"] = opts["top_p"] }
    if opts.has("frequency_penalty") { config["frequency_penalty"] = opts["frequency_penalty"] }
    if opts.has("presence_penalty")  { config["presence_penalty"] = opts["presence_penalty"] }
    if opts.has("stop")              { config["stop"] = opts["stop"] }
    if opts.has("seed")              { config["seed"] = opts["seed"] }
    if opts.has("n")                 { config["n"] = opts["n"] }
    if opts.has("system")            { config["system"] = opts["system"] }
    if opts.has("tools")             { config["tools"] = opts["tools"] }
    if opts.has("tool_choice")       { config["tool_choice"] = opts["tool_choice"] }
    if opts.has("response_format")   { config["response_format"] = opts["response_format"] }
    if opts.has("metadata")          { config["metadata"] = opts["metadata"] }
}

// set_tools(tools) — convenience for the common runtime mutation.
fn set_tools(tools) { config["tools"] = tools }

// Builders for values you put in config.
fn tool(name, description, schema) {
    return { "type": "function",
             "function": { "name": name, "description": description, "parameters": schema } }
}
fn choice_auto()     { return "auto" }
fn choice_none()     { return "none" }
fn choice_required() { return "required" }
fn choice_tool(name) { return { "type": "function", "function": { "name": name } } }
fn json_object() { return { "type": "json_object" } }
fn json_schema(name, schema) {
    return { "type": "json_schema", "json_schema": { "name": name, "schema": schema } }
}

// ── Frame constructors — mirror ovata-infer-protocol response.rs Frame variants ──
fn token(text)         { return { "type": "Token", "text": text } }
fn done(tokens_used)   { return { "type": "Done", "tokens_used": tokens_used } }
fn error(message)      { return { "type": "Error", "message": message } }
fn json_frame(payload) { return { "type": "Json", "json": payload } }

// ── Endpoint + key: config, else env, else installed config file ──
fn base_url() {
    if config["base_url"] != nil { return config["base_url"] }
    let b = env.get("OPENAI_BASE_URL")
    if b != nil { return b }
    return "https://api.openai.com"
}
fn api_key() {
    if config["api_key"] != nil { return config["api_key"] }
    let e = env.get("OPENAI_API_KEY")
    if e != nil { return e }
    let path = env.get("HOME") + "/.jade/providers/openai.json"
    if fs.exists(path) {
        let cfg = json.parse(fs.read(path))
        if cfg.has("api_key") { return cfg["api_key"] }
    }
    return nil
}

// ── Body: the wire request (prompt/model/max_tokens) + the profile config ──
// `system` (config) is a leading role:"system" message, then the wire prompt.
fn build_body(request) {
    let messages = []
    if config["system"] != nil {
        messages.push({ "role": "system", "content": config["system"] })
    }
    messages.push({ "role": "user", "content": request["prompt"] })
    let body = { "messages": messages }

    if request.has("model") && len(request["model"]) > 0 {
        body["model"] = request["model"]
    } else {
        if config["model"] != nil { body["model"] = config["model"] } else { body["model"] = DEFAULT_MODEL }
    }
    if request.has("max_tokens") && request["max_tokens"] > 0 {
        body["max_tokens"] = request["max_tokens"]
    } else {
        if config["max_tokens"] != nil { body["max_tokens"] = config["max_tokens"] } else { body["max_tokens"] = DEFAULT_MAX_TOKENS }
    }

    if config["temperature"] != nil       { body["temperature"] = config["temperature"] }
    if config["top_p"] != nil             { body["top_p"] = config["top_p"] }
    if config["frequency_penalty"] != nil { body["frequency_penalty"] = config["frequency_penalty"] }
    if config["presence_penalty"] != nil  { body["presence_penalty"] = config["presence_penalty"] }
    if config["stop"] != nil              { body["stop"] = config["stop"] }
    if config["seed"] != nil              { body["seed"] = config["seed"] }
    if config["n"] != nil                 { body["n"] = config["n"] }
    if config["tools"] != nil             { body["tools"] = config["tools"] }
    if config["tool_choice"] != nil       { body["tool_choice"] = config["tool_choice"] }
    if config["response_format"] != nil   { body["response_format"] = config["response_format"] }
    if config["metadata"] != nil          { body["metadata"] = config["metadata"] }

    return json.stringify(body)
}

// ── infer(request) -> [Frame] — the protocol-pure inference call ──
// Success -> [Token(text)?, Json(tool_calls)?, Done(tokens_used)]; failure -> [Error].
// The host emits the leading Meta frame, so the profile does not.
fn infer(request) {
    if request.has("rlm") && request["rlm"] {
        return [ error("openai: rlm mode is not supported by a remote provider") ]
    }
    if request.has("grammar") && request["grammar"] != nil {
        return [ error("openai: grammar/constrained decoding is not supported by a remote provider") ]
    }
    if request.has("count_only") && request["count_only"] {
        return [ error("openai: count_only is not supported — OpenAI has no server-side tokenizer endpoint") ]
    }
    let key = api_key()
    if key == nil {
        return [ error("openai: no API key — configure({api_key}), set OPENAI_API_KEY, or add api_key to ~/.jade/providers/openai.json") ]
    }

    let body = build_body(request)
    let resp = http.post(base_url() + "/v1/chat/completions", body, {
        "Authorization": f"Bearer {key}",
        "content-type": "application/json",
    })
    if resp["status"] != 200 {
        return [ error(f"openai: HTTP {resp['status']}: {resp['body']}") ]
    }

    let doc = json.parse(resp["body"])
    let choice = doc["choices"][0]
    let msg = choice["message"]
    let out = []

    if msg.has("content") {
        let c = msg["content"]
        if c != nil {
            if len(c) > 0 {
                out.push(token(c))
            }
        }
    }
    let calls = []
    if msg.has("tool_calls") {
        for tc in msg["tool_calls"] {
            calls.push({ "id": tc["id"], "name": tc["function"]["name"], "arguments": tc["function"]["arguments"] })
        }
    }
    if len(calls) > 0 {
        out.push(json_frame(json.stringify({ "tool_calls": calls, "finish_reason": choice["finish_reason"] })))
    }

    out.push(done(doc["usage"]["total_tokens"]))
    return out
}
