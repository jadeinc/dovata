// 15 — A tool result fed back on the next turn is understood.
//
// The profile carries [tool_result]: the role a result is presented under and the
// wrapping around its content. For Qwen3-Coder that is role `tool` wrapped in
// <tool_response>…</tool_response>, and the qwen35moe family uses role `user`
// instead — the exact detail that must never be hardcoded in a Jade program.
//
// A tool call is only half the loop. 07 and 12 cover the call; nothing covered
// the return leg, where the model has to read a result it did not generate and
// use it. Getting the role or the wrapper wrong does not error — the model just
// fails to connect the result to its call, which reads as the model being bad at
// tools rather than as a profile bug.
//
// The history is sent explicitly through the messages envelope so the result
// lands on a real `tool` turn rather than being pasted into a user string.

use std::json
use std::time

let nonce = time.now_ms()

let ok = false
let detail = ""
try {
    // A value the model cannot know or guess — it can only come from the result.
    let reading = f"{nonce}"

    // Built with stringify rather than written as a literal: the content is itself
    // JSON, and nesting quotes inside an f-string is where these get silently wrong.
    let call_body = json.stringify({"tool_name": "read_sensor"})
    let result_body = json.stringify({"reading": reading})

    let convo = json.stringify({
        "_ovata_infer_protocol": "messages",
        "system": "You are a helpful assistant with tool access. Answer concisely.",
        "messages": [
            {"role": "user", "content": "What is the current sensor reading? Use the sensor tool."},
            {"role": "assistant", "content": f"<tool_call>{call_body}</tool_call>"},
            {"role": "tool", "content": result_body},
            {"role": "user", "content": "What was the reading? Reply with only the number."},
        ],
    })

    prompt p = convo
    let reply = ?p
    detail = f"expected={reading} got={reply.trim()}"
    ok = reply.contains(reading)
} catch e {
    detail = f"raised: {e}"
}

if ok {
    print(f"PASS: tool result on the return leg was understood  [{detail}]")
} else {
    print(f"FAIL: tool-result round trip — {detail}")
}
