// 08 — Coarse end-to-end latency probe.
//
// Measures what the language layer can observe: wall-clock around `?p` derefs, so
// what an actual JADE OS program experiences. True TTFT and tokens-per-second
// belong in a harness that can see individual tokens; this is the end-to-end proxy.
//
// It used to isolate TTFT by capping generation at one token via
// `llm.set_max_tokens(1)`. That is gone — the `llm` package was removed from the
// language, and `max_tokens` with it. A Jade program can express exactly four
// things now: the prompt, a grammar, and the two anchors. So the shape here is a
// short answer against a long one, both uncapped, with the difference attributed
// to decode rather than to a cap the caller no longer controls.
//
// A time-based nonce busts the engine's response cache so each run measures real
// inference rather than a cache replay.

use std::time

let nonce = time.now_ms()

let ok = false
let detail = ""
try {
    // Warm up: the model is resident, but the first call through the provider
    // still pays one-time setup we do not want inside a measurement.
    prompt warm = f"Say hi. ({nonce})"
    let w = ?warm

    // A one-word answer: mostly prefill plus a few tokens.
    prompt short_p = f"What is the capital of France? Reply with only the city name. ({nonce})"
    let t0 = time.now_ms()
    let short_r = ?short_p
    let short_ms = time.now_ms() - t0

    // A long answer over a prompt of similar length: the extra time is decode.
    prompt long_p = f"Write two full paragraphs about the ocean. ({nonce})"
    let t1 = time.now_ms()
    let long_r = ?long_p
    let long_ms = time.now_ms() - t1

    let short_len = short_r.trim().len()
    let long_len = long_r.trim().len()

    // ~4 chars per token, and only the extra characters are attributable to the
    // extra time. Approximate on purpose — a smoke-level throughput figure, not a
    // benchmark, and labelled as such wherever it is reported.
    let extra_chars = long_len - short_len
    let extra_ms = long_ms - short_ms
    let tok_per_s = 0.0
    if extra_ms > 0 && extra_chars > 0 {
        tok_per_s = (extra_chars / 4) * 1000.0 / extra_ms
    }

    print(f"  short reply: {short_len} chars in {short_ms} ms")
    print(f"  long reply:  {long_len} chars in {long_ms} ms")
    print(f"  decode (approx): ~{tok_per_s} tok/s")

    detail = f"short={short_ms}ms long={long_ms}ms tok_s~{tok_per_s}"
    // Deliberately weak: any positive timing on both calls means the round trip
    // works. Asserting a throughput floor on a shared box is how a suite starts
    // failing for reasons that have nothing to do with the engine.
    ok = short_ms > 0 && long_ms > 0 && short_len > 0 && long_len > 0
} catch e {
    detail = f"raised: {e}"
}

if ok {
    print(f"PASS: end-to-end latency probe  [{detail}]")
} else {
    print(f"FAIL: latency probe — {detail}")
}
