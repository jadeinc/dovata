// 03 — JSON object via explicit GBNF.
// Exercises the daemon's complex-type grammar directly (open token + depth-tracked
// span close), asserting parseable JSON — independent of the runtime's struct
// coercion layer (which is tested separately and currently flaky).

use std::json

let OBJ_GBNF = """root   ::= "{" ws pair (ws "," ws pair)* ws "}"
pair   ::= str ws ":" ws val
val    ::= str | num | obj | arr | "true" | "false" | "null"
obj    ::= "{" ws (pair (ws "," ws pair)*)? ws "}"
arr    ::= "[" ws (val (ws "," ws val)*)? ws "]"
str    ::= [\\x22] ([^\\x22\\x5c] | [\\x5c] .)* [\\x22]
num    ::= "-"? [0-9]+ ("." [0-9]+)?
ws     ::= [ ]*"""

let ok = false
let detail = ""
try {
    let g = Grammar.new(OBJ_GBNF)
    prompt p = "Describe the Rust language as a JSON object with keys 'lang' and 'year'."
    let resp = ?p |> g
    detail = resp
    let d = json.parse(resp)
    ok = len(d) > 0
} catch e {
    detail = f"raised: {e}"
}

if ok {
    print(f"PASS: JSON object grammar produced parseable output  [{detail}]")
} else {
    print(f"FAIL: JSON object grammar — {detail}")
}
