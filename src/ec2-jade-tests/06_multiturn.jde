// 06 — Multi-turn conversation via the jade messages protocol.
// Exercises the daemon's `_ovata_infer_protocol: "messages"` path: it parses the
// system + message history and renders it through the model's GGUF chat
// template. A correct answer means prior turns were threaded into the prompt
// (the basis for KV-prefix reuse across turns). Bare consecutive `?p` derefs do
// NOT share history in this runtime, so the history is sent explicitly.

use std::json

let ok = false
let detail = ""
try {
    let convo = json.stringify({
        "_ovata_infer_protocol": "messages",
        "system": "You are a helpful assistant. Answer concisely.",
        "messages": [
            {"role": "user", "content": "Remember this codeword for later: ORCHID."},
            {"role": "assistant", "content": "Understood — the codeword is ORCHID."},
            {"role": "user", "content": "What was the codeword? Reply with only the word."},
        ],
    })
    prompt p = convo
    let ans = ?p
    detail = ans.trim()
    ok = detail.upper().contains("ORCHID")
} catch e {
    detail = f"raised: {e}"
}

if ok {
    print(f"PASS: multi-turn messages protocol threaded history  [{detail}]")
} else {
    print(f"FAIL: multi-turn protocol — {detail}")
}
