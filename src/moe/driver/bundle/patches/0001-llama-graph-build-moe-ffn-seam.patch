+#include "moe_driver.h" // MoE expert-offload seam (no-op when driver inactive)
+
+// Marks this build as carrying the seam in build_moe_ffn below.
+//
+// The bundle that adds the seam adds this with it, so a build whose patch series
+// did not apply has no definition of it. The seam is deliberately a no-op when the
+// driver is inactive, which makes "the patch never applied" and "the driver is
+// correctly disabled" look identical at run time — this is what tells them apart.
+//
+// Declared on the Rust side only (src/moe/ffi.rs), NOT in moe_driver.h:
+// the non-CUDA build compiles moe_stub.cpp, which implements that whole header, and
+// a stub definition here would satisfy the check while proving nothing.
+extern "C" int moe_driver_seam_present(void) { return 1; }
+
 #include "llama-impl.h"
 #include "llama-model.h"
 #include "llama-batch.h"
