diff --git a/ggml/src/ggml-cuda/CMakeLists.txt b/ggml/src/ggml-cuda/CMakeLists.txt
index d3953eee9..42b626bcf 100644
--- a/ggml/src/ggml-cuda/CMakeLists.txt
+++ b/ggml/src/ggml-cuda/CMakeLists.txt
@@ -129,6 +129,24 @@ if (CUDAToolkit_FOUND)
                              ${GGML_SOURCES_CUDA}
                             )
 
+    # MoE expert-offload driver: host policy + driver + ggml graph hook +
+    # the CUDA on-stream pager, all compiled into ggml-cuda so the pager can call
+    # the policy and ggml-cuda's GGML_OP_CUSTOM dispatch can call the pager. The
+    # llama seam (build_moe_ffn) links these symbols via ggml-cuda -> ggml.
+    # JADE_MOE_DRIVER_DIR is passed by the sys crate's build.rs (-D on the cmake
+    # invocation). It is an absolute path, so this works wherever the source tree
+    # is staged and however deep the driver sits relative to it.
+    if (NOT DEFINED JADE_MOE_DRIVER_DIR)
+        message(FATAL_ERROR "the moe bundle was applied but JADE_MOE_DRIVER_DIR is unset")
+    endif()
+    set(MOE_DRIVER_DIR ${JADE_MOE_DRIVER_DIR})
+    target_sources(ggml-cuda PRIVATE
+        ${MOE_DRIVER_DIR}/src/moe_policy.cpp
+        ${MOE_DRIVER_DIR}/src/moe_driver.cpp
+        ${MOE_DRIVER_DIR}/src/graph.cpp
+        ${MOE_DRIVER_DIR}/src/page.cu)
+    target_include_directories(ggml-cuda PRIVATE ${MOE_DRIVER_DIR}/include)
+
     add_compile_definitions(GGML_CUDA_PEER_MAX_BATCH_SIZE=${GGML_CUDA_PEER_MAX_BATCH_SIZE})
 
     if (GGML_CUDA_GRAPHS)
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index d15ccfd99..9532b1f0a 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -54,6 +54,24 @@ target_compile_features   (llama PRIVATE cxx_std_17) # don't bump
 
 target_link_libraries(llama PUBLIC ggml)
 
+# MoE expert-offload driver lives in the ggml-cuda target (see
+# ggml/src/ggml-cuda/CMakeLists.txt). llama only needs the header for the
+# build_moe_ffn seam; the symbols resolve via ggml-cuda -> ggml.
+if (NOT DEFINED JADE_MOE_DRIVER_DIR)
+    message(FATAL_ERROR "the moe bundle was applied but JADE_MOE_DRIVER_DIR is unset")
+endif()
+target_include_directories(llama PRIVATE ${JADE_MOE_DRIVER_DIR}/include)
+
+# ...but the real driver is ONLY compiled into ggml-cuda. On non-CUDA builds
+# (CPU-only inference, or any non-CUDA backend) those symbols don't exist, yet
+# the seam (build_moe_ffn) + the host daemon's moe_driver_init reference them
+# unconditionally. Compile inert host stubs INTO libllama so the same archive
+# that needs the symbols also defines them (no link-order fragility). MoE offload
+# is CUDA-only, so the stubs just report "inactive" and the seam runs stock.
+if (NOT GGML_CUDA)
+    target_sources(llama PRIVATE ${JADE_MOE_DRIVER_DIR}/src/moe_stub.cpp)
+endif()
+
 if (BUILD_SHARED_LIBS)
     set_target_properties(llama PROPERTIES POSITION_INDEPENDENT_CODE ON)
     target_compile_definitions(llama PRIVATE LLAMA_BUILD)
