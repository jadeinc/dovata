# Rust
target/
**/*.rs.bk

# C / CUDA build artifacts — src/infer-engine/moe-driver/ is C++ and CUDA,
# and CMake is pointed at build/.
*.o
build/

# Packaging output. Deleted and recreated by every `cargo run -p packaging` run.
dist/

# Local model files.
# Hardware path: /jade/inference/model.gguf (not in repo)
# Dev path:      models/model.gguf (loaded via JADE_MODEL_PATH)
*.gguf

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Claude
CLAUDE.md

# Credentials and machine-local state
keys/
jade.toml
.env
.ec2.env
.ec2-host
# No trailing slash: on a dev box this is a symlink to a venv shared with the
# sibling jade-os repo, and `.venv/` matches only a real directory.
.venv

# Python bytecode cache (everything under tools/ is Python)
__pycache__/
*.pyc

# Jade/native build artifacts (provider .so live in dist/ or the release bundle)
*.so
*.dylib
